<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/modu_work_widget_background"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="8dp">

  <TextView
    android:layout_width="match_parent"
    android:layout_height="18dp"
    android:fontFamily="sans-serif"
    android:gravity="center"
    android:maxLines="1"
    android:text="9월 5일 토요일"
    android:textColor="#5F6873"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="30dp"
    android:layout_marginLeft="10dp"
    android:layout_marginTop="2dp"
    android:layout_marginRight="10dp"
    android:background="@drawable/modu_work_widget_preview_badge"
    android:backgroundTint="#FFF640"
    android:fontFamily="sans-serif"
    android:gravity="center"
    android:maxLines="1"
    android:text="주간근무"
    android:textColor="#252525"
    android:textSize="16sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="16dp"
    android:layout_marginTop="1dp"
    android:fontFamily="sans-serif"
    android:gravity="center"
    android:maxLines="1"
    android:text="08:00–18:00"
    android:textColor="#343A40"
    android:textSize="9sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="3dp"
    android:layout_marginRight="4dp"
    android:background="@drawable/modu_work_widget_preview_badge"
    android:backgroundTint="#D7DCE2"
    android:ellipsize="end"
    android:fontFamily="sans-serif"
    android:gravity="center"
    android:maxLines="1"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:text="18:00 병원"
    android:textColor="#252525"
    android:textSize="8sp"
    android:textStyle="bold" />
</LinearLayout>
