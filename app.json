{
  "expo": {
    "name": "모두의 근무",
    "slug": "teum",
    "scheme": "teum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/modu-work-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.moduwork.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F1",
        "foregroundImage": "./assets/modu-work-icon-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7354a3b0-31bb-4194-8a1b-6ad78c54a04a"
      }
    },
    "owner": "parkjinhyung123"
  }
}
