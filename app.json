{
  "expo": {
    "name": "모두의 근무",
    "slug": "teum",
    "scheme": "teum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/modu-work-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F6F1",
        "foregroundImage": "./assets/modu-work-icon-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
